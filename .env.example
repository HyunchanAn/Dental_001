# Dental_001 Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit your actual .env file or private credentials to git.

# Hugging Face Access Token (Optional for model/dataset downloads)
HF_TOKEN=your_huggingface_token_here

# Local Device Configuration (cuda, cpu)
DEVICE=cuda

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8001
